<?xml version="1.0" encoding="UTF-8"?>
<grammar
  xmlns="http://relaxng.org/ns/structure/1.0"
  datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <define name="doc">
    <element name="doc" >
      <optional>
        <attribute name="attr">
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>
  <start>
    <choice>
      <ref name="doc"/>
    </choice>
  </start>
</grammar>
